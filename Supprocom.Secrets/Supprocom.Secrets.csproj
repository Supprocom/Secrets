<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Supprocom.Secrets</PackageId>
    <Version>0.1.5</Version>
    <Authors>Supprocom</Authors>
    <PackageLicenseFile>PACKAGE-LICENSE.txt</PackageLicenseFile>
    <Description>Commercial or AGPL-3.0. Provider-neutral secret and configuration overlays for .NET applications.</Description>
    <PackageReleaseNotes>Dual-licensed: Commercial or AGPL-3.0. Adds the Supprocom Commercial License as an alternative to the AGPL-3.0.
Security support until November 2031</PackageReleaseNotes>
    <PackageTags>configuration;dotenv;secrets;IConfiguration</PackageTags>
    <RepositoryUrl>https://github.com/Supprocom/Secrets.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\verification</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <None Update="buildTransitive\Supprocom.Secrets.props">
      <Pack>true</Pack>
      <PackagePath>buildTransitive\Supprocom.Secrets.props</PackagePath>
    </None>
    <None Update="buildTransitive\Supprocom.Secrets.targets">
      <Pack>true</Pack>
      <PackagePath>buildTransitive\Supprocom.Secrets.targets</PackagePath>
    </None>
    <None Include="..\LICENSE" Link="LICENSE" Pack="true" PackagePath="" />
    <None Include="..\NOTICE" Link="NOTICE" Pack="true" PackagePath="" />
    <None Include="..\README.md" Link="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <!-- The package license file is generated from the repository's COMMERCIAL-LICENSE and LICENSE files. -->
  <PropertyGroup>
    <SupprocomPackageLicensePath>$(BaseIntermediateOutputPath)PACKAGE-LICENSE.txt</SupprocomPackageLicensePath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(SupprocomPackageLicensePath)" Pack="true" PackagePath="PACKAGE-LICENSE.txt" Visible="false" />
  </ItemGroup>
  <Target Name="WriteSupprocomPackageLicense" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <_SupprocomCommercialText>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../COMMERCIAL-LICENSE').TrimEnd())))</_SupprocomCommercialText>
      <_SupprocomAgplText>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../LICENSE').TrimEnd())))</_SupprocomAgplText>
      <_SupprocomPackageLicenseText>Commercial or AGPL-3.0

This package is available under your choice of two licenses:
- the Supprocom Commercial License 1.0, for businesses with a registered Supprocom sponsorship (https://github.com/sponsors/Supprocom)%3B or
- the GNU Affero General Public License, version 3 (AGPL-3.0).

Both texts follow. For each version, the COMMERCIAL-LICENSE file in the project's GitHub repository at the commit this package was built from prevails over this copy.

==============================================================================
$(_SupprocomCommercialText)

==============================================================================
$(_SupprocomAgplText)</_SupprocomPackageLicenseText>
    </PropertyGroup>
    <WriteLinesToFile File="$(SupprocomPackageLicensePath)" Lines="$(_SupprocomPackageLicenseText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
